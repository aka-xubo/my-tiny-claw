(version 1)
(deny default)
(allow process-exec)
(allow process-fork)
(allow signal (target self))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow file-read-metadata)
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow ipc-posix-sem)
(allow ipc-posix-shm)
(allow pseudo-tty)
(allow file-read* file-write* (literal "/dev/null") (literal "/dev/zero") (literal "/dev/tty"))
(allow file-read* (require-all (subpath (param "PATH_0")) (require-not (subpath (param "PATH_1")))))

# argv
-D
PATH_0=/
-D
PATH_1=/home/user/.claw/mcp-oauth.json
